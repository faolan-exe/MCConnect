# Copy to deploy/.env and fill in. Never commit the .env file.

# --- domain ---
MCC_DOMAIN=mc.tobisit.de

# --- secrets (generate with: openssl rand -hex 32) ---
DB_PASSWORD=
SECRET_KEY=

# --- email via Strato ---
MCC_SMTP_HOST=smtp.strato.de
MCC_SMTP_PORT=587
MCC_SMTP_USER=
MCC_SMTP_PASSWORD=

# --- operator details for Impressum / Datenschutz (address lines separated by ;) ---
MCC_LEGAL_NAME=
MCC_LEGAL_ADDRESS=Musterstraße 1;12345 Musterstadt
MCC_LEGAL_EMAIL=
MCC_LEGAL_PHONE=

# --- certificate of the plugin connection (required, TLS on port 9991; files in deploy/tls/) ---
MCC_SOCKET_TLS_CERT=/tls/fullchain.pem
MCC_SOCKET_TLS_KEY=/tls/privkey.pem

# --- only for the bundled traefik (docker compose --profile traefik ...) ---
# ACME_EMAIL=admin@tobisit.de
# Cloudflare API token with permission Zone -> DNS -> Edit for tobisit.de
# CF_DNS_API_TOKEN=
# WEB_BIND=127.0.0.1
