# Copy to .env and adjust. All values are optional; defaults match docker/db for local dev.

# --- database ---
MCC_DB_HOST=localhost
MCC_DB_PORT=5432
MCC_DB_NAME=mcConnect-TestDB-1
MCC_DB_USER=admin
MCC_DB_PASSWORD=admin
MCC_TIMEZONE=Europe/Berlin

# --- web (Flask reads every FLASK_* variable into app.config) ---
# Base domain; servers are served on <subdomain>.<this domain>
FLASK_SERVER_NAME=mc.tobisit.de
FLASK_SECRET_KEY=change-me
FLASK_SESSION_COOKIE_SECURE=true
MCC_PUBLIC_SCHEME=https

# --- socket server for the minecraft plugin ---
MCC_SOCKET_HOST=0.0.0.0
MCC_SOCKET_PORT=9991

# --- email (signup verification); without it the link is only logged ---
MCC_SMTP_HOST=
MCC_SMTP_PORT=587
MCC_SMTP_USER=
MCC_SMTP_PASSWORD=
